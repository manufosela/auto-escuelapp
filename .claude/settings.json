{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .karajan/harness/pretooluse.mjs"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .karajan/harness/pretooluse.mjs"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .karajan/harness/pretooluse-sentinel.mjs"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .karajan/harness/pretooluse-sentinel.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .karajan/harness/posttooluse.mjs"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .karajan/harness/posttooluse.mjs"
          }
        ]
      },
      {
        "matcher": "mcp__.*__update_card",
        "hooks": [
          {
            "type": "command",
            "command": "node .karajan/harness/posttooluse.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .karajan/harness/stop.mjs"
          }
        ]
      }
    ]
  }
}
