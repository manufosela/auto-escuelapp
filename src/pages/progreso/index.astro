---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const questions = await getCollection('questions');
const subjectPairs = questions.map((entry) => [entry.id, entry.data.subject]);
---

<BaseLayout
	title="Progreso — auto-escuelapp"
	description="Historial de tests y estadísticas de acierto por tema."
>
	<h1>Progreso</h1>
	<progress-view id="progress-view"></progress-view>
</BaseLayout>

<script>
	import '../../components/progress-view.js';
</script>
<script define:vars={{ subjectPairs }}>
	document.getElementById('progress-view').subjectByQuestionId = new Map(subjectPairs);
</script>
