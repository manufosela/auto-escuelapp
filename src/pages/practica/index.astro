---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const topics = await getCollection('topics');
---

<BaseLayout
	title="Test — auto-escuelapp"
	description="Modo examen y práctica por tema del teórico del permiso B."
>
	<h1>Test</h1>
	<p><a href="/practica/examen/">Empezar examen (30 preguntas, 30 minutos)</a></p>
	<h2>Práctica por tema</h2>
	<ul>
		{
			topics.map((topic) => (
				<li>
					<a href={`/practica/tema/${topic.id}/`}>{topic.data.title}</a>
				</li>
			))
		}
	</ul>
</BaseLayout>
