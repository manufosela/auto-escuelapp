rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Solo usan la app las cuentas con documento en allowedUsers/{uid}
    // (AUT-TSK-0031). Las altas y bajas las hace el administrador desde /admin
    // (AUT-TSK-0033/0034).
    function isAllowed() {
      return request.auth != null
        && exists(/databases/$(database)/documents/allowedUsers/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isAllowed() && request.auth.uid == userId;
    }

    function isSelf(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Administradores: documento en admins/{uid}, que se da de alta a mano en
    // la consola de Firebase. El cliente nunca escribe en esa colección.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{userId} {
      allow get: if isSelf(userId);
      allow list, write: if false;
    }

    // Cada cuenta puede leer su propio documento, para que la app sepa si
    // tiene acceso. El administrador lista, da de alta y quita acceso.
    match /allowedUsers/{userId} {
      allow get: if isSelf(userId) || isAdmin();
      allow list, delete: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'approvedAt'])
        && request.resource.data.name is string
        && request.resource.data.approvedAt is string;
      allow update: if false;
    }

    // Solicitud de acceso: la deja la propia cuenta al entrar sin acceso.
    // Solo el administrador la ve y la rechaza (status) o la borra al aprobar.
    match /accessRequests/{userId} {
      allow get: if isSelf(userId) || isAdmin();
      allow list, delete: if isAdmin();
      allow create: if isSelf(userId)
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'requestedAt', 'status'])
        && request.resource.data.displayName is string
        && request.resource.data.email is string
        && request.resource.data.requestedAt is string
        && request.resource.data.status == 'pending';
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['pending', 'rejected'];
    }

    // Un intento (examen o práctica) es un documento de solo creación:
    // nunca se actualiza ni se borra, para que el historial no se pueda
    // falsificar después de guardado. Solo guarda id de pregunta + acierto,
    // nunca el enunciado (eso vive en la colección pública de contenido).
    function isValidAttempt(data) {
      return data.keys().hasAll(
          ['mode', 'topicId', 'startedAt', 'finishedAt', 'total', 'correct', 'failures', 'passed', 'answers']
        )
        && data.mode in ['exam', 'practice']
        && (data.topicId == null || data.topicId is string)
        && data.startedAt is string
        && data.finishedAt is string
        && data.total is int && data.total >= 0
        && data.correct is int && data.correct >= 0
        && data.failures is int && data.failures >= 0
        && data.correct + data.failures == data.total
        && (data.passed == null || data.passed is bool)
        && data.answers is list
        && data.answers.size() == data.total;
    }

    match /users/{userId}/attempts/{attemptId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidAttempt(request.resource.data);
      allow update, delete: if false;
    }

    // Reporte de una pregunta defectuosa: igual que un intento, de solo
    // creación (nunca se edita ni se borra desde el cliente).
    function isValidQuestionReport(data) {
      return data.keys().hasAll(['questionId', 'reason', 'createdAt'])
        && data.questionId is string && data.questionId.size() > 0
        && data.reason in ['wrong_answer', 'unclear', 'outdated', 'other']
        && data.createdAt is string;
    }

    match /users/{userId}/questionReports/{reportId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidQuestionReport(request.resource.data);
      allow update, delete: if false;
    }

    // Deny-all para todo lo demás.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
