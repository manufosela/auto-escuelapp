rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Un intento (examen o práctica) es un documento de solo creación:
    // nunca se actualiza ni se borra, para que el historial no se pueda
    // falsificar después de guardado. Solo guarda id de pregunta + acierto,
    // nunca el enunciado (eso vive en la colección pública de contenido).
    function isValidAttempt(data) {
      return data.keys().hasAll(
          ['mode', 'topicId', 'startedAt', 'finishedAt', 'total', 'correct', 'failures', 'passed', 'answers']
        )
        && data.mode in ['exam', 'practice']
        && (data.topicId == null || data.topicId is string)
        && data.startedAt is string
        && data.finishedAt is string
        && data.total is int && data.total >= 0
        && data.correct is int && data.correct >= 0
        && data.failures is int && data.failures >= 0
        && data.correct + data.failures == data.total
        && (data.passed == null || data.passed is bool)
        && data.answers is list
        && data.answers.size() == data.total;
    }

    match /users/{userId}/attempts/{attemptId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidAttempt(request.resource.data);
      allow update, delete: if false;
    }

    // Reporte de una pregunta defectuosa: igual que un intento, de solo
    // creación (nunca se edita ni se borra desde el cliente).
    function isValidQuestionReport(data) {
      return data.keys().hasAll(['questionId', 'reason', 'createdAt'])
        && data.questionId is string && data.questionId.size() > 0
        && data.reason in ['wrong_answer', 'unclear', 'outdated', 'other']
        && data.createdAt is string;
    }

    match /users/{userId}/questionReports/{reportId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidQuestionReport(request.resource.data);
      allow update, delete: if false;
    }

    // Deny-all para todo lo demás.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
